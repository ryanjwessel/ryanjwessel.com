---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { work } from '../../data/site';
export function getStaticPaths() {
  return work.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
const other = work.find((entry) => entry.slug !== item.slug);
---
<BaseLayout title={`${item.title} | Ryan Wessel`} description={item.summary} path={`/work/${item.slug}`}>
  <section class="page-hero container case-hero"><a class="back-link" href="/work">← All work</a><p class="eyebrow">{item.category}</p><h1>{item.title}</h1><p class="page-lead">{item.summary}</p><p class="case-role">{item.role}<br /><span>Professional work at Dataminr</span></p></section>
  <div class="container case-body">
    {item.sections.map((section, index) => (
      <section class="story-section"><p class="eyebrow">0{index + 1} / {section.label}</p><div><h2>{section.title}</h2><p>{section.body}</p></div></section>
    ))}
    {other && <a class="portfolio-link next-story" href={`/work/${other.slug}`}><span><span class="eyebrow">Another perspective</span><strong>{other.title}</strong></span><span aria-hidden="true">↗</span></a>}
  </div>
</BaseLayout>
