---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleList from '../components/ArticleList.astro';
import { articles, site } from '../data/site';
---
<BaseLayout title="Writing & Runtime Leadership | Ryan Wessel" description="Selected practical essays for engineers leading complex work and managers building reliable teams, from Ryan Wessel’s Runtime Leadership." path="/writing">
  <section class="page-hero container"><p class="eyebrow">Writing</p><h1>Make sense of it.<br />Make it useful.</h1><p class="page-lead">Writing is how I clarify what I’m learning about engineering leadership. Runtime Leadership is where I share the practices, questions, and decision frames that help in real work.</p></section>
  <section class="publication container" aria-labelledby="publication-heading"><div><p class="eyebrow">An independent publication by Ryan Wessel</p><h2 id="publication-heading">Runtime Leadership</h2><p>Practical systems for software engineers and engineering managers leading complex work and reliable teams.</p></div><a class="button" href={site.substack}>Read & subscribe ↗</a></section>
  <section class="section container reading-path"><div class="section-heading"><div><p class="eyebrow">01 / Lead The Work</p><h2>Move complex<br />work forward.</h2></div><p>Technical direction, architectural change, tradeoffs, and ownership. For engineers leading consequential work, whether or not they manage people.</p></div><ArticleList items={articles.filter((article) => article.path === 'Lead The Work')} /></section>
  <div class="blue-surface">
  <section class="section container reading-path"><div class="section-heading"><div><p class="eyebrow">02 / Lead The Team</p><h2>Build the conditions<br />for good work.</h2></div><p>Direction, trust, growth, and operating rhythms. For managers helping teams make good decisions and take ownership.</p></div><ArticleList items={articles.filter((article) => article.path === 'Lead The Team')} /><p class="writing-note">Two scopes of leadership, not steps on a career ladder. <a class="text-link" href={`${site.substack}/p/start-here`}>Find more starting points ↗</a></p></section>
  </div>
</BaseLayout>
